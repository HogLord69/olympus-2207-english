# Game files, except the localized ones under payload/ which are the point of
# the repo (see README). Without the exception a new payload asset is skipped
# silently by `git add` -- which is how sfall/translations.ini went missing.
*.dat
*.DAT
*.orig
*.frm
*.FRM
*.exe
*.dll
*.pdf
!payload/**

# Python
__pycache__/
*.py[cod]

# Built release archives - multi-GB, never committed
/release/
*.zip

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
